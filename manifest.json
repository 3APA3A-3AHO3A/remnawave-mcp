{
  "manifest_version": "0.3",
  "name": "remnawave-mcp",
  "display_name": "Remnawave",
  "version": "1.4.2",
  "description": "Remnawave 3.x panels in Claude (up to 3 in one extension): users, nodes, traffic, devices, GeoCheck. Read-only, secrets and client data hidden.",
  "long_description": "Ask about your Remnawave panel in plain language — or about up to three panels at once: online users, offline nodes, traffic, a client's subscription and devices, suspected subscription sharing, GeoCheck.\n\n- Read-only: nothing in the panel can be changed.\n- Tools are generated from the official @remnawave/backend-contract.\n- Privacy filter on your computer: Reality keys, passwords, UUIDs and connection links are hidden; client usernames, e-mails, Telegram IDs, IPs and HWIDs are replaced with pseudonyms.\n- The API token is stored in the system keychain.",
  "author": {
    "name": "3APA3A-3AHO3A",
    "url": "https://github.com/3APA3A-3AHO3A"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/3APA3A-3AHO3A/remnawave-mcp"
  },
  "homepage": "https://github.com/3APA3A-3AHO3A/remnawave-mcp",
  "documentation": "https://github.com/3APA3A-3AHO3A/remnawave-mcp#readme",
  "support": "https://github.com/3APA3A-3AHO3A/remnawave-mcp/issues",
  "icon": "icon.png",
  "license": "MIT",
  "keywords": [
    "remnawave",
    "xray",
    "vpn",
    "vless",
    "panel"
  ],
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/index.js"
      ],
      "env": {
        "REMNAWAVE_NAME": "${user_config.panel_name}",
        "REMNAWAVE_BASE_URL": "${user_config.base_url}",
        "REMNAWAVE_API_TOKEN": "${user_config.api_token}",
        "REMNAWAVE_2_NAME": "${user_config.panel_name_2}",
        "REMNAWAVE_2_BASE_URL": "${user_config.base_url_2}",
        "REMNAWAVE_2_API_TOKEN": "${user_config.api_token_2}",
        "REMNAWAVE_3_NAME": "${user_config.panel_name_3}",
        "REMNAWAVE_3_BASE_URL": "${user_config.base_url_3}",
        "REMNAWAVE_3_API_TOKEN": "${user_config.api_token_3}",
        "REMNAWAVE_PRIVACY": "${user_config.privacy}",
        "REMNAWAVE_PRIVACY_SALT": "${user_config.privacy_salt}",
        "REMNAWAVE_API_KEY": "${user_config.api_key}",
        "CF_ACCESS_CLIENT_ID": "${user_config.cf_client_id}",
        "CF_ACCESS_CLIENT_SECRET": "${user_config.cf_client_secret}",
        "REMNAWAVE_RUNTIME": "mcpb"
      }
    }
  },
  "tools_generated": true,
  "prompts": [
    {
      "name": "daily_summary",
      "description": "Panel summary: users, online, offline nodes, traffic, expiring subscriptions",
      "text": "daily_summary"
    },
    {
      "name": "client_review",
      "description": "Subscription, devices, traffic and recent requests of one client",
      "arguments": [
        "user"
      ],
      "text": "client_review"
    },
    {
      "name": "sharing_audit",
      "description": "Clients who probably share their subscription",
      "text": "sharing_audit"
    },
    {
      "name": "node_check",
      "description": "Offline nodes, load balance, optional GeoCheck",
      "arguments": [
        "node"
      ],
      "text": "node_check"
    }
  ],
  "compatibility": {
    "platforms": [
      "win32",
      "darwin",
      "linux"
    ],
    "runtimes": {
      "node": ">=22.0.0"
    }
  },
  "user_config": {
    "privacy": {
      "type": "string",
      "title": "Privacy / Приватность",
      "description": "strict (recommended) · basic · off",
      "default": "strict",
      "required": false
    },
    "privacy_salt": {
      "type": "string",
      "title": "Pseudonym salt (optional) / Соль псевдонимов",
      "description": "Keeps pseudonyms after a restart",
      "sensitive": true,
      "required": false
    },
    "panel_name": {
      "type": "string",
      "title": "Panel 1 name / Имя панели 1",
      "description": "e.g. main (latin, digits, - _)",
      "required": false
    },
    "base_url": {
      "type": "string",
      "title": "Panel 1 URL / Адрес панели 1",
      "description": "https://panel.example.com",
      "required": true
    },
    "api_token": {
      "type": "string",
      "title": "Panel 1 API token / API-токен панели 1",
      "description": "Read scopes only",
      "sensitive": true,
      "required": true
    },
    "panel_name_2": {
      "type": "string",
      "title": "Panel 2 name (optional) / Имя панели 2",
      "description": "e.g. second",
      "required": false
    },
    "base_url_2": {
      "type": "string",
      "title": "Panel 2 URL (optional) / Адрес панели 2",
      "description": "https://panel2.example.com",
      "required": false
    },
    "api_token_2": {
      "type": "string",
      "title": "Panel 2 API token (optional) / API-токен панели 2",
      "description": "Read scopes only",
      "sensitive": true,
      "required": false
    },
    "panel_name_3": {
      "type": "string",
      "title": "Panel 3 name (optional) / Имя панели 3",
      "description": "e.g. third",
      "required": false
    },
    "base_url_3": {
      "type": "string",
      "title": "Panel 3 URL (optional) / Адрес панели 3",
      "description": "https://panel3.example.com",
      "required": false
    },
    "api_token_3": {
      "type": "string",
      "title": "Panel 3 API token (optional) / API-токен панели 3",
      "description": "Read scopes only",
      "sensitive": true,
      "required": false
    },
    "api_key": {
      "type": "string",
      "title": "Panel 1 behind Caddy: X-Api-Key (optional)",
      "description": "Only with a secret path and API key",
      "sensitive": true,
      "required": false
    },
    "cf_client_id": {
      "type": "string",
      "title": "Panel 1 behind Cloudflare Access: Client ID (optional)",
      "description": "Only for Cloudflare Access",
      "required": false
    },
    "cf_client_secret": {
      "type": "string",
      "title": "Panel 1 behind Cloudflare Access: Client Secret (optional)",
      "description": "Only for Cloudflare Access",
      "sensitive": true,
      "required": false
    }
  }
}
